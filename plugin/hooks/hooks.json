{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "PY=\"$(command -v python3 || command -v python)\"; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/qc_guard.py\"", "timeout": 30}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "PY=\"$(command -v python3 || command -v python)\"; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/qc_guard.py\"", "timeout": 10}
        ]
      }
    ]
  }
}
